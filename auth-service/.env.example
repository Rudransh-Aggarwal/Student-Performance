NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://admin:devpassword@localhost:27017/student_prediction?authSource=admin
CLIENT_URL=http://localhost:5173

# Firebase project id (Firebase console > Project settings). This is all the server needs.
FIREBASE_PROJECT_ID=

# Internal service-to-service auth (shared with data-service).
AUTH_SERVICE_SECRET=development-service-secret

# data-service base URL, for recording role changes and clearing module assignments on demotion.
DATA_SERVICE_URL=http://localhost:4100

# Only for the admin scripts (seed:admin, migrate:users): a service account key. Never commit it.
# Either point GOOGLE_APPLICATION_CREDENTIALS at the downloaded JSON file, or set the two values below.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=