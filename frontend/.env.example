# Firebase console > Project settings > Your apps > Web app. These identify the project and are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Social buttons to show (each must also be enabled in Firebase console > Authentication > Sign-in method)
VITE_AUTH_PROVIDERS=google,github
# Leave empty to use the same origin (Nginx in Docker, Vite proxy in development).
# Set only to call a service directly, e.g. http://localhost:4100 and http://localhost:5000.
VITE_DATA_SERVICE_URL=
VITE_ML_SERVICE_URL=