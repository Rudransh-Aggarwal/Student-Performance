# Copy to .env in the project root and fill in. Values come from the Firebase console > Project settings.

# Backend (auth-service, data-service)
FIREBASE_PROJECT_ID=your-firebase-project-id
AUTH_SERVICE_SECRET=development-service-secret

# Frontend build (public web config, baked into the bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=
VITE_AUTH_PROVIDERS=google,github